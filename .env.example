# ---------------------------------------------------------------------------
# Farm City environment variables. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# The business WhatsApp number in international format WITHOUT the leading '+'
# (e.g. 254712345678). Used to build wa.me links from the storefront.
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"

# Public base URL of the storefront (used in messages / links).
NEXT_PUBLIC_SITE_URL="https://farm-city-red.vercel.app"

# --- Meta WhatsApp Cloud API (bot side) ---
# Permanent/system-user access token for the WhatsApp Business account.
WHATSAPP_TOKEN=""
# The phone number ID (NOT the phone number) from the Meta app dashboard.
WHATSAPP_PHONE_NUMBER_ID=""
# A token you invent; Meta echoes it back when verifying the webhook.
WHATSAPP_VERIFY_TOKEN="farm-city-verify"
# App secret, used to validate the X-Hub-Signature-256 header on webhooks.
WHATSAPP_APP_SECRET=""
# Graph API version.
WHATSAPP_GRAPH_VERSION="v21.0"

# Where new-order alerts are sent to the team (WhatsApp number, no '+').
TEAM_ALERT_WHATSAPP_NUMBER="254700000000"

# M-Pesa payment display details (shown to the customer in chat).
MPESA_PAYBILL="000000"
MPESA_ACCOUNT_PREFIX="FC"

# Minutes an unpaid order waits before the bot sends a reminder / lapses.
UNPAID_REMINDER_MINUTES="120"
